# Ejecución local que replica el release. Copiar a .env.qa (ignorado por git) con valores de PRUEBA.
# Mismos nombres que las variables del pipeline: en Linux Azure DevOps las expone en MAYÚSCULA.
# OJO: USER y HOST también existen en el sistema; QaEvidencia valida que no conserven el valor del agente.
DB=
HOST=
PORT=__DB_PORT__
USER=
PASSWORD=
