{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vulcano.local/schemas/bob-manifest.schema.json",
  "title": "Vulcano Bob manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "updated_at",
    "resources_root",
    "source_manifest",
    "source_snapshot",
    "adapter_selection",
    "terraform_profile",
    "preflight",
    "target_repo",
    "closure_index",
    "artifacts",
    "operational_pending",
    "manual_steps_done",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": 4 },
    "project": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "resources_root": { "type": "string", "minLength": 1 },
    "source_manifest": { "type": "string", "minLength": 1 },
    "source_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_updated_at", "cloud_provider", "iac", "devops_platform"],
      "properties": {
        "manifest_updated_at": { "type": "string" },
        "cloud_provider": { "type": "string", "minLength": 1 },
        "iac": { "type": "string", "minLength": 1 },
        "devops_platform": { "type": "string", "minLength": 1 }
      }
    },
    "adapter_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cloud", "iac", "pipeline", "remote_operator", "status"],
      "properties": {
        "cloud": { "type": "string", "minLength": 1 },
        "iac": { "type": "string", "minLength": 1 },
        "pipeline": { "type": "string", "minLength": 1 },
        "remote_operator": { "type": ["string", "null"] },
        "status": { "const": "implemented" }
      }
    },
    "terraform_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_version", "provider_constraints", "module_standard", "execution_backend", "test_strategy", "registry_source", "registry_mcp", "adoption_mode"],
      "properties": {
        "required_version": { "type": "string", "minLength": 1 },
        "provider_constraints": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[A-Za-z0-9_-]+$" },
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "module_standard": { "enum": ["internal", "avm"] },
        "execution_backend": { "enum": ["azure_devops", "github_actions", "gitlab_ci", "hcp_terraform"] },
        "test_strategy": { "enum": ["plan_mock", "plan_mock_and_integration"] },
        "registry_source": { "enum": ["public", "private", "mixed", "none"] },
        "registry_mcp": { "enum": ["read_only", "disabled"] },
        "adoption_mode": { "enum": ["none", "moved_import"] }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checked_at", "conflicts", "capabilities"],
      "properties": {
        "status": { "enum": ["pending", "ready", "blocked"] },
        "checked_at": { "type": ["string", "null"] },
        "conflicts": { "type": "array", "items": { "type": "object" } },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["terraform_registry_mcp", "terraform_style_guide", "terraform_test", "azure_verified_modules", "refactor_module", "terraform_search_import"],
          "properties": {
            "terraform_registry_mcp": { "enum": ["unknown", "available", "missing", "disabled"] },
            "terraform_style_guide": { "enum": ["unknown", "available", "missing"] },
            "terraform_test": { "enum": ["unknown", "available", "missing"] },
            "azure_verified_modules": { "enum": ["unknown", "available", "missing", "not_required"] },
            "refactor_module": { "enum": ["unknown", "available", "missing", "not_required"] },
            "terraform_search_import": { "enum": ["disabled", "available", "missing"] }
          }
        }
      }
    },
    "target_repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iac_root", "pipeline_files"],
      "properties": {
        "iac_root": { "type": "string", "minLength": 1 },
        "pipeline_files": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "closure_index": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/artifact" }
    },
    "operational_pending": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "owner"],
        "properties": {
          "id": { "type": "string", "pattern": "^OP-\\d{3}$" },
          "description": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 }
        }
      }
    },
    "manual_steps_done": { "type": "array", "items": { "type": "string" } },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["last_run", "errors", "warnings"],
      "properties": {
        "last_run": { "type": ["string", "null"] },
        "errors": { "type": ["integer", "null"], "minimum": 0 },
        "warnings": { "type": ["integer", "null"], "minimum": 0 }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "status", "depends_on", "contract", "source_docs", "source_hashes", "validated"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pending", "generated", "conflict", "omitted"] },
        "reason": { "type": "string", "minLength": 1 },
        "depends_on": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inputs", "outputs"],
          "properties": {
            "inputs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "outputs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
          }
        },
        "source_docs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "source_hashes": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
        "validated": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "validate", "test", "lint", "security", "syntax", "last_run"],
          "properties": {
            "format": { "type": ["boolean", "null"] },
            "validate": { "type": ["boolean", "null"] },
            "test": { "type": ["boolean", "string", "null"] },
            "lint": { "type": ["boolean", "string", "null"] },
            "security": { "type": ["boolean", "string", "null"] },
            "syntax": { "type": ["boolean", "null"] },
            "last_run": { "type": ["string", "null"] },
            "evidence": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["status", "tool", "run_at"],
                "properties": {
                  "status": { "enum": ["passed", "failed", "skipped"] },
                  "tool": { "type": "string", "minLength": 1 },
                  "tool_version": { "type": ["string", "null"] },
                  "command": { "type": "string" },
                  "exit_code": { "type": ["integer", "null"] },
                  "output_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                  "reason": { "type": "string", "minLength": 1 },
                  "run_at": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    }
  }
}
