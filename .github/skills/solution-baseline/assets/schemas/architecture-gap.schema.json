{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/solution-baseline/architecture-gap.schema.json",
  "title": "Solution Baseline Architecture Gap",
  "type": "object",
  "required": ["schema_version", "gap_id", "solution_id", "status", "category", "question", "impact", "requested_decision", "evidence"],
  "properties": {
    "schema_version": { "const": 1 },
    "gap_id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
    "solution_id": { "type": "string", "minLength": 1 },
    "component_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "status": { "enum": ["open", "resolved", "accepted"] },
    "category": { "enum": ["topology", "component-boundary", "ownership", "contract", "security", "architecture-style", "stack", "other"] },
    "question": { "type": "string", "minLength": 1 },
    "impact": { "type": "string", "minLength": 1 },
    "requested_decision": { "type": "string", "minLength": 1 },
    "architecture_sources": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "summary"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "section": { "type": "string" },
          "summary": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "resolution": {
      "type": "object",
      "required": ["decision_id", "value", "resolved_by", "resolved_at", "source"],
      "properties": {
        "decision_id": { "type": "string", "minLength": 1 },
        "value": {},
        "resolved_by": { "type": "string", "minLength": 1 },
        "resolved_at": { "type": "string", "format": "date-time" },
        "source": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["resolved", "accepted"] } }, "required": ["status"] },
      "then": { "required": ["resolution"] }
    }
  ],
  "additionalProperties": false
}
