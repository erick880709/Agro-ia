{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/solution-baseline/solution-blueprint.schema.json",
  "title": "Solution Baseline Blueprint",
  "type": "object",
  "required": ["schema_version", "solution", "sources", "components"],
  "properties": {
    "schema_version": { "const": 1 },
    "solution": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "kind", "status"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["architecture", "adr", "openapi", "asyncapi", "schema", "ux", "design-system", "code", "roadmap", "other"] },
          "status": { "$ref": "#/$defs/evidenceStatus" },
          "sha256": { "$ref": "#/$defs/sha256" }
        },
        "additionalProperties": false
      }
    },
    "catalogs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "namespace", "source", "trust", "priority"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "namespace": { "$ref": "#/$defs/id" },
          "source": { "type": "string", "minLength": 1 },
          "trust": { "enum": ["official", "approved", "experimental"] },
          "priority": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "path", "status"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["openapi", "asyncapi", "json-schema", "protobuf", "graphql", "other"] },
          "path": { "type": "string", "minLength": 1 },
          "status": { "enum": ["draft", "frozen", "approved"] },
          "producers": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
          "consumers": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
          "sha256": { "$ref": "#/$defs/sha256" }
        },
        "additionalProperties": false
      }
    },
    "decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/decision" }
    },
    "exclusions": {
      "type": "array",
      "items": { "enum": ["cicd", "iac", "containers", "cloud-provisioning", "deployment", "production-observability"] },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
    "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "evidenceStatus": { "enum": ["confirmed", "inferred", "pending"] },
    "decision": {
      "type": "object",
      "required": ["id", "status", "value", "sources"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "status": { "$ref": "#/$defs/evidenceStatus" },
        "value": {},
        "sources": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "rationale": { "type": "string" }
      },
      "additionalProperties": false
    },
    "versionRequest": {
      "type": "object",
      "required": ["intent"],
      "properties": {
        "intent": { "enum": ["stable", "recommended", "preview", "exact"] },
        "requested": { "type": "string", "minLength": 1 },
        "resolved": { "type": "string", "minLength": 1 },
        "scheme": { "enum": ["semver", "pep440", "maven", "nuget", "generic"] }
      },
      "allOf": [
        {
          "if": { "properties": { "intent": { "const": "exact" } } },
          "then": { "required": ["requested"] }
        }
      ],
      "additionalProperties": false
    },
    "frozenArtifact": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "designSystem": {
      "type": "object",
      "required": ["source", "status"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/evidenceStatus" },
        "tokens": { "type": "array", "items": { "$ref": "#/$defs/frozenArtifact" } },
        "components_catalog": { "$ref": "#/$defs/frozenArtifact" },
        "brand_assets": { "$ref": "#/$defs/frozenArtifact" },
        "package": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "$ref": "#/$defs/versionRequest" }
          },
          "additionalProperties": false
        },
        "style_zones": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "literal_exemptions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "max_literal_violations": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": ["id", "requirement", "workload", "repository", "strategy", "stack"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "requirement": { "type": "string", "minLength": 1 },
        "workload": { "enum": ["web", "api", "worker", "agent", "integrations", "library"] },
        "repository": {
          "type": "object",
          "required": ["id", "path"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "path": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "strategy": { "enum": ["create", "reconcile", "upgrade"] },
        "stack": {
          "type": "object",
          "required": ["language", "runtime"],
          "properties": {
            "language": { "type": "string", "minLength": 1 },
            "runtime": { "$ref": "#/$defs/versionRequest" },
            "framework": { "type": "string" },
            "framework_version": { "$ref": "#/$defs/versionRequest" },
            "package_manager": { "type": "string" },
            "package_manager_version": { "$ref": "#/$defs/versionRequest" },
            "architecture_style": { "type": "string" }
          },
          "additionalProperties": false
        },
        "capabilities": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "design_system": { "$ref": "#/$defs/designSystem" },
        "depends_on": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "contracts": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "security_requirements": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "quality_gates": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": false
    }
  }
}
