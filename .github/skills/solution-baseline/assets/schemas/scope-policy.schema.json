{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/solution-baseline/scope-policy.schema.json",
  "title": "Solution Baseline Scope Boundary Policy",
  "type": "object",
  "required": [
    "schema_version",
    "owner",
    "forbidden_directories",
    "forbidden_files",
    "forbidden_suffixes",
    "forbidden_file_globs",
    "forbidden_path_sequences"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "owner": { "const": "vulcano" },
    "forbidden_directories": { "$ref": "#/$defs/uniqueStrings" },
    "forbidden_files": { "$ref": "#/$defs/uniqueStrings" },
    "forbidden_suffixes": { "$ref": "#/$defs/uniqueStrings" },
    "forbidden_file_globs": { "$ref": "#/$defs/uniqueStrings" },
    "forbidden_path_sequences": {
      "type": "array",
      "items": { "$ref": "#/$defs/uniqueStrings" },
      "minItems": 1
    }
  },
  "$defs": {
    "uniqueStrings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "minItems": 1
    }
  },
  "additionalProperties": false
}
