{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/solution-baseline/receipt.schema.json",
  "title": "Solution Baseline Receipt",
  "type": "object",
  "required": ["schema_version", "repository_id", "provenance", "generator", "ownership", "validations"],
  "properties": {
    "schema_version": { "const": 1 },
    "repository_id": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "format": "date-time" },
    "provenance": {
      "type": "object",
      "required": ["family", "version", "source", "digest"],
      "properties": {
        "namespace": { "type": "string" },
        "family": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1, "not": { "const": "latest" } },
        "source": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "minLength": 1 },
        "license": { "type": "string" }
      },
      "additionalProperties": false
    },
    "generator": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1, "not": { "const": "latest" } },
        "version_scheme": { "enum": ["semver", "pep440", "maven", "nuget", "generic"] },
        "adapter": { "type": "string" }
      },
      "additionalProperties": false
    },
    "parameters": { "type": "object" },
    "capabilities": { "type": "array", "items": { "type": "object" } },
    "overlays": { "type": "array", "items": { "type": "object" } },
    "ownership": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "category"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "category": { "enum": ["managed", "extendable", "project_owned", "generated_once", "ignored"] },
          "sha256": { "$ref": "#/$defs/sha256" },
          "extension_points": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "input_hash": { "$ref": "#/$defs/sha256" },
    "output_hash": { "$ref": "#/$defs/sha256" },
    "migrations": { "type": "array", "items": { "type": "object" } },
    "accepted_drift": { "type": "array", "items": { "type": "object" } },
    "validations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["passed", "failed", "skipped", "accepted"] },
          "command": { "type": "string" },
          "evidence": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
  }
}
