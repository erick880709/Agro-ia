{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/solution-baseline/catalog.schema.json",
  "title": "Solution Archetype Catalog",
  "type": "object",
  "required": ["schema_version", "namespace", "owner", "archetypes"],
  "properties": {
    "schema_version": { "const": 1 },
    "namespace": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "owner": { "type": "string", "minLength": 1 },
    "trust": { "enum": ["official", "approved", "experimental"] },
    "archetypes": {
      "type": "array",
      "items": { "$ref": "#/$defs/archetype" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "archetype": {
      "type": "object",
      "required": ["id", "family", "version", "status", "workload", "owner", "source", "digest", "license", "generator", "compatibility"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "family": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "version": { "$ref": "#/$defs/version" },
        "status": { "enum": ["supported", "deprecated", "retired", "experimental"] },
        "workload": { "enum": ["web", "api", "worker", "agent", "integrations", "library"] },
        "owner": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "generator": {
          "type": "object",
          "required": ["id", "version", "contract"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1, "not": { "const": "latest" } },
            "version_scheme": { "enum": ["semver", "pep440", "maven", "nuget", "generic"] },
            "contract": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "compatibility": {
          "type": "object",
          "required": ["language"],
          "properties": {
            "language": { "type": "string", "minLength": 1 },
            "runtime": { "type": "string" },
            "framework": { "type": "string" },
            "framework_version": { "type": "string" },
            "version_scheme": { "enum": ["semver", "pep440", "maven", "nuget", "generic"] },
            "architecture_styles": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "supported": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "required": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "incompatible": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
          },
          "additionalProperties": false
        },
        "permissions": {
          "type": "object",
          "properties": {
            "network": { "type": "boolean", "default": false },
            "hooks": { "type": "boolean", "default": false },
            "writes_outside_target": { "type": "boolean", "default": false }
          },
          "additionalProperties": false
        },
        "exclusions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "migrations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to", "path"],
            "properties": {
              "from": { "$ref": "#/$defs/version" },
              "to": { "$ref": "#/$defs/version" },
              "path": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
