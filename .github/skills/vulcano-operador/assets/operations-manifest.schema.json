{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vulcano.local/schemas/operator-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "updated_at", "source", "operator_selection", "gate", "mode", "target", "capabilities", "reconciliation", "actions", "validation"],
  "properties": {
    "schema_version": { "const": 2 },
    "project": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["bob_manifest", "bob_sha256", "git_commit"],
      "properties": {
        "bob_manifest": { "type": "string", "minLength": 1 },
        "bob_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "git_commit": { "type": ["string", "null"] }
      }
    },
    "operator_selection": {
      "type": "object", "additionalProperties": false,
      "required": ["platform", "cloud", "status"],
      "properties": {
        "platform": { "type": "string", "minLength": 1 },
        "cloud": { "type": "string", "minLength": 1 },
        "status": { "const": "implemented" }
      }
    },
    "gate": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "checked_at", "blockers"],
      "properties": {
        "status": { "enum": ["pending", "ready", "blocked"] },
        "checked_at": { "type": ["string", "null"] },
        "blockers": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "mode": { "enum": ["reconcile", "plan", "authorize", "operate", "verify"] },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["organization", "project", "repository", "branch"],
      "properties": {
        "organization": { "type": ["string", "null"] },
        "project": { "type": ["string", "null"] },
        "repository": { "type": ["string", "null"] },
        "branch": { "type": ["string", "null"] }
      }
    },
    "capabilities": {
      "type": "object", "additionalProperties": false,
      "required": ["platform_mcp", "cloud_mcp"],
      "properties": {
        "platform_mcp": { "enum": ["unknown", "available", "missing"] },
        "cloud_mcp": { "enum": ["unknown", "available", "missing"] }
      }
    },
    "reconciliation": {
      "type": "object", "additionalProperties": false,
      "required": ["observed_at", "tool", "snapshot_sha256"],
      "properties": {
        "observed_at": { "type": ["string", "null"] },
        "tool": { "type": ["string", "null"] },
        "snapshot_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "actions": { "type": "object", "additionalProperties": { "$ref": "#/$defs/action" } },
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": ["last_run", "errors", "warnings"],
      "properties": {
        "last_run": { "type": ["string", "null"] },
        "errors": { "type": ["integer", "null"], "minimum": 0 },
        "warnings": { "type": ["integer", "null"], "minimum": 0 }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["tool", "result", "scope_hash", "request_sha256", "response_sha256", "recorded_at"],
      "properties": {
        "tool": { "type": "string", "minLength": 1 },
        "result": { "enum": ["succeeded", "failed"] },
        "scope_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "request_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "response_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "external_id": { "type": ["string", "null"] },
        "recorded_at": { "type": "string", "minLength": 1 }
      }
    },
    "action": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "risk", "logical_id", "target_ref", "environment", "desired_sha256", "observed_sha256", "diff_summary", "scope_hash", "status", "proposed_at", "authorization", "execution", "verification"],
      "properties": {
        "type": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "risk": { "enum": ["configure", "execute"] },
        "logical_id": { "type": "string", "minLength": 1 },
        "target_ref": { "type": "string", "minLength": 1 },
        "environment": { "enum": ["dev", "qa", "prod", null] },
        "desired_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "observed_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "diff_summary": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "scope_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "status": { "enum": ["proposed", "authorized", "running", "succeeded", "failed", "verified", "cancelled"] },
        "proposed_at": { "type": "string", "minLength": 1 },
        "authorization": {
          "type": ["object", "null"], "additionalProperties": false,
          "required": ["authorized_by", "authorized_at", "expires_at", "scope_hash", "confirmation_sha256"],
          "properties": {
            "authorized_by": { "type": "string", "minLength": 1 },
            "authorized_at": { "type": "string", "minLength": 1 },
            "expires_at": { "type": "string", "minLength": 1 },
            "scope_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "confirmation_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "execution": { "oneOf": [{ "$ref": "#/$defs/evidence" }, { "type": "null" }] },
        "verification": { "oneOf": [{ "$ref": "#/$defs/evidence" }, { "type": "null" }] }
      }
    }
  }
}
