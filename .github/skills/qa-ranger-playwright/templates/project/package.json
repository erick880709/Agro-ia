    "@playwright/test": "{{PLAYWRIGHT_VERSION}}",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.0",
    "eslint": "^10.0.0",
    "eslint-plugin-playwright": "^2.12.0",
    "playwright-ctrf-json-reporter": "^0.1.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.0"
  }
}
