    <diagram id="c3-componentes" name="C3 - Componentes Motor ML">
        <mxGraphModel dx="390" dy="211" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="c3-0"/>
                <mxCell id="c3-1" parent="c3-0"/>
                <mxCell id="c3-title" value="C3 - Componentes: Motor de Recomendaciones Inteligentes (AgroIA)" style="text;fontSize=16;fontStyle=1;align=center;" parent="c3-1" vertex="1">
                    <mxGeometry x="300" y="10" width="800" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="c3-spa" value="SPA Angular" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" parent="c3-1" vertex="1">
                    <mxGeometry x="40" y="100" width="100" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="c3-api" value="API Gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" parent="c3-1" vertex="1">
                    <mxGeometry x="40" y="180" width="100" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="c3-pg" value="PostgreSQL&#xa;+pgvector" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" parent="c3-1" vertex="1">
                    <mxGeometry x="40" y="380" width="90" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="c3-boundary" value="&lt;b&gt;Contenedor: ML Inference Service&lt;/b&gt; (FastAPI + MLflow)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;dashed=1;dashPattern=8 8;" parent="c3-1" vertex="1">
                    <mxGeometry x="220" y="60" width="1050" height="700" as="geometry"/>
                </mxCell>
                <mxCell id="c3-orch" value="&lt;b&gt;Recommendation Orchestrator&lt;/b&gt;&#xa;&#xa;Coordina el pipeline completo&#xa;de recomendación:&#xa;1. Recibe solicitud (POST /recommend)&#xa;2. Valida parámetros y permisos&#xa;3. Invoca modelos ML por tipo&#xa;4. Aplica reglas agronómicas&#xa;5. Detecta discordancia ML vs reglas&#xa;6. Ensambla respuesta final&#xa;7. Registra métricas en MLflow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" parent="c3-1" vertex="1">
                    <mxGeometry x="580" y="120" width="280" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="c3-model-rf" value="&lt;b&gt;Modelo Random Forest&lt;/b&gt;&#xa;&#xa;Predicción de rendimiento&#xa;F1 &gt; 0.80&#xa;Entradas: 18 vars suelo&#xa;+ clima + historial" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" parent="c3-1" vertex="1">
                    <mxGeometry x="240" y="120" width="200" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="c3-model-xgb" value="&lt;b&gt;Modelo XGBoost&lt;/b&gt;&#xa;&#xa;Clasificación de suelo&#xa;según UPRA&#xa;F1 &gt; 0.82" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" parent="c3-1" vertex="1">
                    <mxGeometry x="240" y="270" width="200" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="c3-model-lstm" value="&lt;b&gt;Modelo LSTM&lt;/b&gt;&#xa;&#xa;Series temporales NDVI&#xa;Predicción fenológica&#xa;Revisita 5 días" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" parent="c3-1" vertex="1">
                    <mxGeometry x="240" y="410" width="200" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="c3-model-fusion" value="&lt;b&gt;Ensemble / Fusión&lt;/b&gt;&#xa;&#xa;Combina salidas RF +&#xa;XGBoost + LSTM&#xa;Ponderación bayesiana" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" parent="c3-1" vertex="1">
                    <mxGeometry x="240" y="550" width="200" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="c3-rules" value="&lt;b&gt;Agronomic Rules Engine&lt;/b&gt;&#xa;&#xa;• Reglas UPRA oficiales&#xa;• Restricciones fenológicas&#xa;• Compatibilidad cultivo-suelo&#xa;• Ventanas de siembra&#xa;• Umbrales de alerta&#xa;&#xa;Ej: pH&lt;4.5 → corrección encalado&#xa;obligatoria antes de recomendar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" parent="c3-1" vertex="1">
                    <mxGeometry x="940" y="120" width="240" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="c3-discord" value="&lt;b&gt;Discordance Resolver&lt;/b&gt;&#xa;&#xa;Detecta conflicto:&#xa;ML recomienda cultivo X&#xa;pero reglas lo prohíben&#xa;&#xa;→ Marca &quot;requiere revisión&quot;&#xa;→ Notifica al técnico&#xa;→ SLA: ≤ 10 días hábiles&#xa;   o se bloquea la recomendación" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" parent="c3-1" vertex="1">
                    <mxGeometry x="940" y="370" width="240" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="c3-data-adapter" value="&lt;b&gt;Data Adapters&lt;/b&gt;&#xa;&#xa;• SueloAdapter (18 vars)&#xa;• ClimaAdapter (IDEAM)&#xa;• NDVIAdapter (Copernicus)&#xa;• GISAdapter (PostGIS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" parent="c3-1" vertex="1">
                    <mxGeometry x="580" y="500" width="200" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="c3-mlflow" value="&lt;b&gt;MLflow&lt;/b&gt;&#xa;&#xa;Registry de modelos&#xa;Métricas de drift&#xa;A/B testing" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="c3-1" vertex="1">
                    <mxGeometry x="580" y="380" width="130" height="100" as="geometry"/>
