                <mxCell id="s2-h-notif" value="&lt;b&gt;Notification&#xa;Service&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;" vertex="1" parent="s2-1">
                    <mxGeometry x="1045" y="45" width="90" height="40" as="geometry"/>
