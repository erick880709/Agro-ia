                    <mxGeometry x="30" y="570" width="700" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="s2-m10" value="BLOQUEO: Se notifica al agricultor que la recomendación no está disponible.&#xa;Se escala al administrador. La finca queda marcada como &quot;pendiente revisión técnica&quot;." style="text;html=1;fontSize=9;fillColor=#f8cecc;align=left;whiteSpace=wrap;" vertex="1" parent="s2-1">
