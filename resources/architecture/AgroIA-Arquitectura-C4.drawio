                        <mxPoint x="560" y="310" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s1-m7" value="5. predict(suelo, clima, NDVI)" style="endArrow=classic;html=1;fontSize=9;strokeWidth=1.5;" parent="s1-1" edge="1">
