                <mxCell id="s3-h-alert" value="&lt;b&gt;Alert&#xa;Service&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=8;" parent="s3-1" vertex="1">
                    <mxGeometry x="1025" y="40" width="70" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="s3-m1" value="1. Mide 18 variables&#xa;(cada 15-30 min)" style="endArrow=classic;html=1;fontSize=9;" parent="s3-1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="60" y="120" as="sourcePoint"/>
                        <mxPoint x="200" y="120" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s3-m2" value="2. Frame LoRaWAN&#xa;{device_id, payload, rssi}" style="endArrow=classic;html=1;fontSize=9;" parent="s3-1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="200" y="170" as="sourcePoint"/>
                        <mxPoint x="340" y="170" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s3-m3" value="3. Decodifica payload,&#xa;normaliza variables&#xa;(pH, NPK, humedad...)" style="endArrow=classic;html=1;fontSize=9;" parent="s3-1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="340" y="230" as="sourcePoint"/>
                        <mxPoint x="340" y="290" as="targetPoint"/>
                        <Array as="points">
                            <mxPoint x="340" y="260"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s3-m4" value="4. Publica evento&#xa;&quot;sensor.data.received&quot;&#xa;routing_key: finca.{id}" style="endArrow=classic;html=1;fontSize=9;" parent="s3-1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="340" y="330" as="sourcePoint"/>
                        <mxPoint x="500" y="330" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s3-m5" value="5. Consume evento&#xa;(ack automático)" style="endArrow=classic;html=1;fontSize=9;" parent="s3-1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="500" y="390" as="sourcePoint"/>
                        <mxPoint x="680" y="390" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s3-m6" value="6. Validación calidad:&#xa;• Rangos físicos (pH 0-14)&#xa;• Coherencia temporal&#xa;• Sensor no offline &gt;24h" style="endArrow=classic;html=1;fontSize=9;" parent="s3-1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="680" y="450" as="sourcePoint"/>
                        <mxPoint x="680" y="510" as="targetPoint"/>
                        <Array as="points">
                            <mxPoint x="680" y="480"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s3-m7" value="7. INSERT INTO sensor_data&#xa;(finca_id, var, valor, ts)&#xa;partición TimescaleDB" style="endArrow=classic;html=1;fontSize=9;" parent="s3-1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="680" y="550" as="sourcePoint"/>
                        <mxPoint x="880" y="550" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s3-m8" value="8. OK (datos persistidos)" style="endArrow=open;html=1;fontSize=9;dashed=1;" parent="s3-1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="880" y="590" as="sourcePoint"/>
                        <mxPoint x="680" y="590" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s3-alt-label" value="&lt;b&gt;alt&lt;/b&gt; [Sensor offline &gt; 24 horas]" style="text;html=1;fontSize=10;fontStyle=1;align=left;fillColor=#f8cecc;" parent="s3-1" vertex="1">
                    <mxGeometry x="680" y="650" width="380" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="s3-alt-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;opacity=20;dashed=1;" parent="s3-1" vertex="1">
                    <mxGeometry x="670" y="640" width="400" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="s3-m9" value="6b. Detecta last_seen &gt; 24h&#xa;→ Marca finca &quot;datos desactualizados&quot;" style="endArrow=classic;html=1;fontSize=9;fillColor=#f8cecc;" parent="s3-1" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="680" y="690" as="sourcePoint"/>
                        <mxPoint x="880" y="690" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s3-m10" value="7b. Dispara alerta&quot;&#xa;al agricultor y técnico" style="endArrow=classic;html=1;fontSize=9;fillColor=#f8cecc;" parent="s3-1" edge="1">
                    <mxGeometry relative="1" as="geometry">
