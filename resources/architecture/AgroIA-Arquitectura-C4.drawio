                <mxCell id="s3-h-rabbit" value="&lt;b&gt;RabbitMQ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=8;" parent="s3-1" vertex="1">
                    <mxGeometry x="460" y="45" width="70" height="30" as="geometry"/>
                </mxCell>
