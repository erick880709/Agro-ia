                        <mxPoint x="760" y="380" as="sourcePoint"/>
                        <mxPoint x="760" y="420" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s2-m5" value="5. Notifica: &quot;Nuevo caso de discordancia DISC-0042 requiere revisión&quot;" style="endArrow=classic;html=1;fontSize=9;fillColor=#ffe6cc;" edge="1" parent="s2-1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="760" y="470" as="sourcePoint"/>
                        <mxPoint x="1100" y="470" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s2-m6" value="6. Email/Notificación a técnico asignado" style="endArrow=classic;html=1;fontSize=9;" edge="1" parent="s2-1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1100" y="520" as="sourcePoint"/>
                        <mxPoint x="940" y="520" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <!-- alt block - Technician response -->
                <mxCell id="s2-alt-start" value="&lt;b&gt;alt&lt;/b&gt; [Técnico responde ≤ 10 días]" style="text;html=1;fontSize=10;fontStyle=1;align=left;fillColor=#f5f5f5;" vertex="1" parent="s2-1">
                    <mxGeometry x="760" y="580" width="340" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="s2-alt-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;opacity=40;dashed=1;" vertex="1" parent="s2-1">
                    <mxGeometry x="750" y="570" width="350" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="s2-m7" value="7. Revisa caso, decide:&#xa;• Override: fuerza regla → cultivo alternativo&#xa;• Confirma ML: documenta excepción" style="endArrow=classic;html=1;fontSize=9;fillColor=#d5e8d4;" edge="1" parent="s2-1">
