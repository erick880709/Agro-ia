                        <mxPoint x="1060" y="750" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s3-note" value="&lt;b&gt;Variables monitoreadas (18):&lt;/b&gt;&#xa;pH, N, P, K, Ca, Mg, S, Fe, Mn, Zn, Cu, B,&#xa;MO (materia orgánica), CIC, textura (arena/limo/arcilla),&#xa;humedad, temperatura suelo, CE (conductividad eléctrica)&#xa;&#xa;&lt;b&gt;Frecuencia:&lt;/b&gt; 15-30 min | &lt;b&gt;Batería:&lt;/b&gt; &gt;12 meses (solar)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=10;fontSize=8;align=left;" parent="s3-1" vertex="1">
