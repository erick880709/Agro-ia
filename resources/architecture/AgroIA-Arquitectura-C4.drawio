                <mxCell id="s2-m2" value="2. validate(cultivo=&quot;Arroz&quot;, suelo)" style="endArrow=classic;html=1;fontSize=9;" edge="1" parent="s2-1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="220" y="210" as="sourcePoint"/>
                        <mxPoint x="580" y="210" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s2-m2r" value="❌ {status:&quot;FORBIDDEN&quot;,&#xa;reason: &quot;pH 5.2 muy bajo para arroz&#xa;(mín 6.0 UPRA)&quot;}" style="endArrow=open;html=1;fontSize=9;dashed=1;fillColor=#f8cecc;" edge="1" parent="s2-1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="580" y="250" as="sourcePoint"/>
                        <mxPoint x="220" y="250" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s2-m3" value="3. ML(Arroz, 0.91) vs Rules(FORBIDDEN) → DISCORDANCIA" style="endArrow=classic;html=1;fontSize=9;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="s2-1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="220" y="310" as="sourcePoint"/>
                        <mxPoint x="760" y="310" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s2-m4" value="4. Crea caso de revisión:&#xa;{id: &quot;DISC-0042&quot;, finca, cultivo_ml, cultivo_rules, motivo}" style="endArrow=classic;html=1;fontSize=9;" edge="1" parent="s2-1">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="760" y="370" as="sourcePoint"/>
                        <mxPoint x="760" y="370" as="targetPoint"/>
                        <Array as="points"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s2-m4-self" value="4. Crea caso DISC-0042&#xa;en PostgreSQL" style="endArrow=classic;html=1;fontSize=9;" edge="1" parent="s2-1">
