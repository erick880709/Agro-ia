                <mxCell id="s2-alt-end" value="&lt;b&gt;else&lt;/b&gt; [&gt;10 días sin respuesta]" style="text;html=1;fontSize=10;fontStyle=1;align=left;fillColor=#f8cecc;" vertex="1" parent="s2-1">
