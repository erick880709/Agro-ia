# AgroIA — Variables de entorno compartidas
# Copiar a .env y ajustar valores para desarrollo local

# ── Base de datos ──
DATABASE_URL=postgresql+asyncpg://agroia:agroia_dev@localhost:5432/agroia
DATABASE_URL_SYNC=postgresql://agroia:agroia_dev@localhost:5432/agroia
POSTGRES_USER=agroia
POSTGRES_PASSWORD=agroia_dev
POSTGRES_DB=agroia

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── RabbitMQ ──
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_QUEUE_IOT=sensor.data.received

# ── JWT ──
# HS256 por defecto: JWT_SECRET con 32+ caracteres. Si existen las claves PEM,
# se usa RS256 en su lugar.
JWT_SECRET=cambia-esta-clave-por-una-de-32-caracteres-minimo
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
# AUTH_ALLOW_LEGACY_HEADERS=true  # solo para debugging en desarrollo

# ── OpenAI (RAG) ──
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4

# ── AWS ──
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET=agroia-reports-dev

# ── APIs externas ──
IDEAM_API_URL=https://api.ideam.gov.co
IDEAM_API_KEY=your-ideam-key
COPERNICUS_API_URL=https://scihub.copernicus.eu
GOOGLE_MAPS_API_KEY=your-google-maps-key

# ── Observabilidad ──
LOG_LEVEL=INFO
ENVIRONMENT=development
